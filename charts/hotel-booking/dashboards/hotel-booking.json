    {
      "id": 3,
      "type": "timeseries",
      "title": "Частка помилок 5xx",
      "description": "Поріг автоматичного відкату: успішних запитів менше 95%, тобто 5xx більше 5%",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
